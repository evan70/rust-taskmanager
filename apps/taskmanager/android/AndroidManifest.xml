<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.heartnetapps.taskmanager">

    <!-- lets the app use Shizuku, if the person has it (an optional way to start the helper) -->
    <uses-permission android:name="moe.shizuku.manager.permission.API_V23" />
    <!-- detailed mode talks to the phone's own debugging service and its helper, both on this phone (127.0.0.1) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- the notification that takes the pairing code -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- which apps can be seen: those that start at boot -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <intent>
            <action android:name="android.intent.action.BOOT_COMPLETED" />
        </intent>
        <intent>
            <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
        </intent>
    </queries>

    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="Task Manager"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name="dev.heartnetapps.kit.KitActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|uiMode|density|smallestScreenSize|navigation|keyboard"
            android:launchMode="singleTask">
            <meta-data android:name="android.app.lib_name" android:value="taskmgr" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name="dev.heartnetapps.taskmanager.PairReceiver" android:exported="false" />

        <!-- how Shizuku hands this app its connection -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="dev.heartnetapps.taskmanager.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <meta-data android:name="moe.shizuku.client.V3_SUPPORT" android:value="true" />
    </application>
</manifest>
